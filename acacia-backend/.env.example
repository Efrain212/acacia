# NO subas este archivo a GitHub. Poné tu token de PRUEBA acá.
# Obtenelo en: https://www.mercadopago.com.ar/developers -> Tus aplicaciones -> Credenciales de prueba
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxx
PORT=3001
FRONT_URL=http://localhost:5500
# Para producción usarás APP_USR-... y back_urls con tu dominio real
# MySQL (XAMPP por defecto)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=acacia
# Gmail para enviar códigos (NO pongas tu clave normal: creá App Password)
# Gmail -> Cuenta -> Seguridad -> Verificación 2 pasos -> Contraseñas de aplicaciones -> Correo -> copiá 16 letras
# OJO: sacá tus datos reales de este archivo de ejemplo, van solo en .env
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASS=xxxx-xxxx-xxxx-xxxx
# Admin (demo local)
ADMIN_USER=admin-acacia
ADMIN_PASS=aca.admin98
ADMIN_KEY=acacia-admin
